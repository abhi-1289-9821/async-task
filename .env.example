# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (SQLite):
DATABASE_URL=sqlite:///./billing_disputes.db
# Production (Neon PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://user:password@ep-xxx.us-east-2.aws.neon.tech/billing_disputes

# ── Gemini AI (required before Phase 3) ──────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
# Set to the model name you want — never hardcoded in code.
# Example values: gemini-2.0-flash, gemini-1.5-pro, gemini-2.0-pro-exp
GEMINI_MODEL=gemini-2.0-flash

# ── LLM mode ─────────────────────────────────────────────────────────────────
# "mock" for automated tests only. "real" for all other runs.
# Production must NOT set this to "mock". The app raises an error if
# LLM_MODE=mock is detected outside of test mode.
LLM_MODE=real

# ── Demo Auth ─────────────────────────────────────────────────────────────────
# SECURITY DISCLAIMER: This is a demo-only auth mechanism.
# Tokens map to roles: REVIEWER (can approve credits) / VIEWER (read-only).
# There is no password storage, no per-user ownership, no token expiry.
# Change these from the defaults before any public deployment.
DEMO_REVIEWER_TOKEN=change-me-reviewer-secret
DEMO_VIEWER_TOKEN=change-me-viewer-secret

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
APP_VERSION=0.1.0
# Comma-separated origins for CORS (frontend URL in production)
CORS_ORIGINS=http://localhost:5173
