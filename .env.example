# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8000
DEBUG=false
APP_VERSION=0.1.0

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (SQLite with WAL mode and foreign keys):
DATABASE_URL=sqlite:///./billing_disputes.db
# Production (Neon PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://user:password@ep-xxx.us-east-2.aws.neon.tech/billing_disputes

# ── LLM Providers & Fallback Order ───────────────────────────────────────────
# Ordered comma-separated list of providers to attempt:
LLM_PROVIDERS=gemini,groq,openrouter

# Primary: Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite

# Secondary fallback: Groq (https://console.groq.com)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Tertiary fallback: OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemini-2.5-flash

# ── LLM Mode ─────────────────────────────────────────────────────────────────
# "mock" for automated tests only. "real" for live AI investigations.
# Hard security guard: when ENVIRONMENT=production, config.py enforces that
# LLM_MODE must be "real" and at least one provider must be fully configured.
LLM_MODE=real

# ── Demo & Multi-User Auth ───────────────────────────────────────────────────
# Bearer tokens mapping to roles: REVIEWER (can approve credits) / VIEWER (read-only).
# In local development: defaults to demo-reviewer-token-2026 / demo-viewer-token-2026
# In production: config.py strictly rejects default tokens at startup to protect endpoints.
DEMO_REVIEWER_TOKEN=demo-reviewer-token-2026
DEMO_VIEWER_TOKEN=demo-viewer-token-2026

# Optional multi-user reviewer tokens with identity mapping:
# REVIEWER_TOKENS="token_alice:alice@acme.com,token_bob:bob@acme.com"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins for CORS (frontend URL in production)
CORS_ORIGINS=http://localhost:5173
