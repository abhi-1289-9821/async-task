# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8000
DEBUG=false
APP_VERSION=0.1.0

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (SQLite with WAL mode and foreign keys):
DATABASE_URL=sqlite:///./billing_disputes.db
# Production (Neon PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://user:password@ep-xxx.us-east-2.aws.neon.tech/billing_disputes

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Required for live agent investigation in production.
GEMINI_API_KEY=your-gemini-api-key-here
# Set to the model name you want — never hardcoded in code.
# Recommended: gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.1-flash-lite

# ── LLM Mode ─────────────────────────────────────────────────────────────────
# "mock" for automated tests only. "real" for live AI investigations.
# Hard security guard: when ENVIRONMENT=production, config.py enforces that
# LLM_MODE must be "real" and GEMINI_API_KEY must be configured, raising a fatal
# ValueError at startup if set to "mock" or if keys are empty.
LLM_MODE=real

# ── Demo Auth ─────────────────────────────────────────────────────────────────
# Bearer tokens mapping to roles: REVIEWER (can approve credits) / VIEWER (read-only).
# In production, config.py strictly rejects default demo tokens at startup.
DEMO_REVIEWER_TOKEN=change-me-reviewer-secret
DEMO_VIEWER_TOKEN=change-me-viewer-secret

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins for CORS (frontend URL in production)
CORS_ORIGINS=http://localhost:5173
