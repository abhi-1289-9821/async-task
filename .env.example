# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in configuration. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment & Server ─────────────────────────────────────────────────────
ENVIRONMENT=
PORT=
DEBUG=
APP_VERSION=

# ── Database ──────────────────────────────────────────────────────────────────
# e.g. sqlite:///./billing_disputes.db or postgresql+psycopg2://...
DATABASE_URL=

# ── Investigation TTL ────────────────────────────────────────────────────────
# Duration in seconds before an abandoned RUNNING investigation is reaped as FAILED
INVESTIGATION_RUN_TTL_SECONDS=

# ── LLM Providers & Fallback Order ───────────────────────────────────────────
# e.g. gemini,groq,openrouter
LLM_PROVIDERS=

# Primary Provider (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=

# Fallback Provider (Groq)
GROQ_API_KEY=
GROQ_MODEL=

# Fallback Provider (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Execution Mode: "mock" for offline deterministic tests; "real" for live inference
LLM_MODE=

# ── Authentication & Authorization Tokens ─────────────────────────────────────
# Bearer tokens (required for API access; no hardcoded defaults allowed in production)
DEMO_REVIEWER_TOKEN=
DEMO_VIEWER_TOKEN=

# Optional comma-separated list of token:identity pairs for multi-user review
# e.g. rev_token_alice:alice@domain.com,rev_token_bob:bob@domain.com
REVIEWER_TOKENS=

# ── Security & CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=
